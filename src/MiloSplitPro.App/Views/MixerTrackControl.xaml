<UserControl x:Class="MiloSplitPro.App.Views.MixerTrackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="700">
    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Margin="0,4" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <!-- Stem Name -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{Binding StemName}" Foreground="White" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="{Binding DurationFormatted}" Foreground="#94A3B8" FontSize="11" />
            </StackPanel>

            <!-- Peak Meter Badge -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding PeakAmplitude, StringFormat={}{0:F2} pk}" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" />
            </Border>

            <!-- Mute Button -->
            <ToggleButton Grid.Column="3" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                          Content="MUTE"
                          Style="{StaticResource MuteToggleButtonStyle}"
                          Width="44" Height="28" Margin="2" />

            <!-- Solo Button -->
            <ToggleButton Grid.Column="4" IsChecked="{Binding IsSolo, Mode=TwoWay}"
                          Content="SOLO"
                          Style="{StaticResource SoloToggleButtonStyle}"
                          Width="44" Height="28" Margin="2" />

            <!-- Volume Slider -->
            <Slider Grid.Column="5" Minimum="0.0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="12,0" SmallChange="0.05" LargeChange="0.1" />

            <!-- Volume Percent Text -->
            <TextBlock Grid.Column="6" Text="{Binding VolumePercentFormatted}" Foreground="#CBD5E1"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
