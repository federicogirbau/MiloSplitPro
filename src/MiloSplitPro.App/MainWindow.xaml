<Window x:Class="MiloSplitPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiloSplitPro.App.ViewModels"
        xmlns:views="clr-namespace:MiloSplitPro.App.Views"
        mc:Ignorable="d"
        Title="Milo Split Pro — Separación Musical con IA"
        Icon="Assets/app_icon.png"
        Height="820" Width="1200" MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="#0B0F19">
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="42" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar / Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CUSTOM TITLE BAR -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand & Icon -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center: Title / Drag area -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Hardware Badge & Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/app_icon.png" Width="28" Height="28" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="Milo Split Pro" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI STUDIO" FontSize="9" FontWeight="Bold" Foreground="#818CF8" />
                    </Border>
                </StackPanel>

                <!-- Center: Draggable area / subtitle -->
                <TextBlock Grid.Column="1" Text="Separación multipista por inteligencia artificial local"
                           Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Hardware Chip + Window Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Hardware Badge -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 " FontSize="10" />
                            <TextBlock Text="{Binding HardwareInfo.GpuName, StringFormat={}GPU: {0}}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Minimize Button -->
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" Click="TitleBar_Minimize_Click" ToolTip="Minimizar" />
                    <!-- Maximize / Restore Button -->
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" Click="TitleBar_Maximize_Click" ToolTip="Maximizar" />
                    <!-- Close Button -->
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="TitleBar_Close_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <!-- Left Panel (Setup & Input) -->
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="20" />
                <!-- Right Panel (Mixer & Player) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 1. Input File Section -->
                        <TextBlock Text="1. CANCIÓN DE ENTRADA" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                        
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding InputFileName}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="{Binding FormatInfo}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,10" />
                                <Button Content="Elegir Archivo..." Command="{Binding BrowseInputFileCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Stems Selection -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="2. QUÉ PISTAS SEPARAR" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Todas" Command="{Binding SelectAllStemsCommand}" Background="Transparent" Foreground="#6366F1" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <Button Content="Ninguna" Command="{Binding DeselectAllStemsCommand}" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding VocalsSelected}" Content="🎤  Voces (Voz general)" Foreground="White" Margin="0,4" />
                                <CheckBox IsChecked="{Binding LeadVocalsSelected}" Content="   ↳ Voz Principal (Lead)" Foreground="#CBD5E1" Margin="20,2" />
                                <CheckBox IsChecked="{Binding BackingVocalsSelected}" Content="   ↳ Coros / Segundas Voces" Foreground="#CBD5E1" Margin="20,2" />
                                <Separator Background="#1E293B" Margin="0,6" />
                                <CheckBox IsChecked="{Binding DrumsSelected}" Content="🥁  Batería Completa" Foreground="White" Margin="0,4" />
                                <CheckBox IsChecked="{Binding BassSelected}" Content="🎸  Bajo" Foreground="White" Margin="0,4" />
                                <CheckBox IsChecked="{Binding GuitarSelected}" Content="🪕  Guitarras" Foreground="White" Margin="0,4" />
                                <CheckBox IsChecked="{Binding PianoSelected}" Content="🎹  Piano y Teclados" Foreground="White" Margin="0,4" />
                                <Separator Background="#1E293B" Margin="0,6" />
                                <CheckBox IsChecked="{Binding GenerateComplementOther}" Content="🎛️  Generar complemento (Other)" Foreground="#A5B4FC" FontWeight="SemiBold" Margin="0,4" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Destination Folder & Format -->
                        <TextBlock Text="3. CARPETA Y FORMATO DE EXPORTACIÓN" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="📁" Command="{Binding BrowseOutputFolderCommand}" Background="#1E293B" Foreground="White" BorderBrush="#334155" BorderThickness="1" Width="38" Height="36" Margin="6,0,0,0" Cursor="Hand" />
                        </Grid>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="MP3 (320k)" IsChecked="{Binding IsMp3Format, Mode=TwoWay}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <RadioButton Grid.Column="1" Content="WAV (24-bit)" IsChecked="{Binding IsWavFormat, Mode=TwoWay}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <RadioButton Grid.Column="2" Content="FLAC" IsChecked="{Binding IsFlacFormat, Mode=TwoWay}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 4. Action Button -->
                        <Button Content="⚡ SEPARAR Y EXPORTAR" Command="{Binding StartSeparationCommand}"
                                IsEnabled="{Binding CanStartSeparation}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="48" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                        <Button Content="Cancelar Proceso" Command="{Binding CancelSeparationCommand}"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                                Background="#EF4444" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="2" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Progress & Status Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Master Player Transport Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Multi-track Mixer View -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Action Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Header -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding CurrentStageText, StringFormat={}Etapa: {0}}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,6" />
                                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="6" Foreground="#6366F1" Background="#1E293B" BorderThickness="0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" Foreground="#6366F1" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Transport Bar -->
                    <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Play / Pause Button -->
                            <Button Grid.Column="0" Command="{Binding PlayPauseCommand}"
                                    Width="44" Height="44" Style="{StaticResource PrimaryButtonStyle}" Padding="0" Cursor="Hand"
                                    ToolTip="Reproducir / Pausar (Espacio)">
                                <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="Segoe UI Symbol, Arial, sans-serif" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- Stop Button -->
                            <Button Grid.Column="1" Command="{Binding StopPlaybackCommand}"
                                    Width="36" Height="36" Background="#334155" Foreground="White" BorderThickness="0" Margin="8,0,16,0" Cursor="Hand"
                                    ToolTip="Detener">
                                <Rectangle Width="12" Height="12" Fill="White" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- Time Position -->
                            <TextBlock Grid.Column="2" Text="{Binding PositionFormatted}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <!-- Timeline Slider -->
                            <Slider x:Name="TimelineSlider" Grid.Column="3"
                                    Minimum="0" Maximum="{Binding TimelineMaximumSec}"
                                    Value="{Binding TimelinePositionSec, Mode=OneWay}"
                                    PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                                    PreviewMouseMove="TimelineSlider_PreviewMouseMove"
                                    VerticalAlignment="Center" Margin="8,0" />

                            <!-- Total Duration -->
                            <TextBlock Grid.Column="4" Text="{Binding TotalDurationFormatted}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Mixer Tracks List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding SeparatedTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:MixerTrackControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Action Bar -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Atajo: Espacio para Play / Pausa" Foreground="#64748B" FontSize="11" />
                        </StackPanel>

                        <!-- Open Output Folder -->
                        <Button Grid.Column="1" Content="📂 Abrir Carpeta" Command="{Binding OpenOutputFolderCommand}"
                                Background="#1E293B" Foreground="White" BorderBrush="#334155" BorderThickness="1"
                                Padding="14,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" />

                        <!-- Export Mix Button -->
                        <Button Grid.Column="2" Content="🎚️ Exportar Mezcla" Command="{Binding ExportMixCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Milo Split Pro v1.0.0 — Procesamiento 100% local y privado sin telemetría externa" Foreground="#475569" FontSize="11" />
            <TextBlock Text="NAudio WASAPI Sample-Accurate Engine | Licencias y SBOM verificados" Foreground="#475569" FontSize="11" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
